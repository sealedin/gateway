# Copy to .env and fill in. Never commit .env.
# Chutes API key (cpk_...): the egress attests and invokes Chutes TEE instances with it.
CHUTES_API_KEY=
# Dev stack only (the CVM derives its master key from the guest agent). Generate: openssl rand -hex 32, prefixed
# with sk-; never run a placeholder. The identity reads the same value as SEALEDIN_LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=
# Operator bearer for the identity's key issuance (/v1/keys on the private listener); any random secret in dev.
SEALEDIN_OPERATOR_API_KEY=
# Measured deployments also need (see scripts/env-from-keychain.sh):
POSTGRES_PASSWORD=
# SEALEDIN_EDGE_DOMAIN exists only in the sealed env file scripts/deploy-phala.sh writes; the local stack does not use it.
