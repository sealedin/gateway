# golang:1.27.4-alpine by index digest; scripts/check-image-pins.sh rejects any tag (docs/litellm-pin.md).
FROM golang@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false \
    -ldflags "-s -w -buildid=" -o /out/gateway-rpcproxy ./cmd/rpcproxy

# gcr.io/distroless/static-debian13:nonroot by index digest; see scripts/check-image-pins.sh.
FROM gcr.io/distroless/static-debian13@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=build /out/gateway-rpcproxy /gateway-rpcproxy
# The RPC hosts are measured with the image: rpcproxy/policy.yaml is a governance input, not operator config.
COPY rpcproxy/policy.yaml /policy.yaml
EXPOSE 8475
ENTRYPOINT ["/gateway-rpcproxy"]
